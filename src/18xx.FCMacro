def createBoard():
    # configuration = GridConfiguration(1, 0, 1, HexTimeShiftDirection.UP)
    # configuration = GridConfiguration(1, 1, 2, HexTimeShiftDirection.UP)
    # configuration = GridConfiguration(2, 2, 4, HexTimeShiftDirection.UP)
    # configuration = GridConfiguration(2, 1, 4)
    # configuration = GridConfiguration(3, 4, 3)
    dimensions = GridDimensions(
        hexWidth=28,
        pinWidth=3.5,
        pinLength=6,
        pinRadius=1,
        pinHeight=8.5,
        floorThickness=1.6,
        ceilingThickness=0.8,
        ceilingLedgeThickness=1,
        ceilingLedgeDelta=0.4,
        ceilingHollowDelta=1.2,
        adjacentDistance=1.2,
        magnetDiameter=3,
        magnetHeightFloor=3,
        magnetHeightCeiling=2,
        extruderWidth=0.42
    )

    # hexBoard = HexBoard(configuration, dimensions)
    # hexBoard.createBoard()

    condensedBoard = CondensedBoard(dimensions, 8)
    # condensedBoard.createBoard()
    condensedBoard.createLid()

def createCompanyBox():
    companyBoxDimensions = company.Dimensions(
        lid=LidDimensions(
            lidLength=41,
            lidWidthBack=62.8,
            lidHeight=2.8
        ),

        wallThickness=4,
        floorHeight=0.8,

        cylinderObjectSets=[
            CylinderObjectSet(name="markers", diameter=13.4, height=7, count=2),
            CylinderObjectSet(name="stations", diameter=10.95, height=10.3, count=5)
        ]
    )
    companyBox = CompanyBox(companyBoxDimensions)
    companyBox.createBox()

def createCharterBox():
    charterBoxDimensions = charters.Dimensions(
        lid=LidDimensions(
            lidLength=127,
            lidWidthBack=190.8,
            lidHeight=3.5,
            simplify=True
        ),

        wallThickness=6,
        floorHeight=0.8,

        markers=CylinderObjectSet(diameter=13.4, height=7),
        stations=CylinderObjectSet(diameter=10.95, height=10.3),

        fontHeight=1.2,
        numberSpace=7,
        numberFontSize=4,
        cylinderDistanceY=4,
        numberFont="C:/Windows/Fonts/arialbd.ttf",
        # numberFont="C:/Windows/Fonts/osifont-lgpl3fe.ttf"

        playerCubeSpaceWidth=9,
        timberCubeSpaceWidth=55,
        playerCubeSpaceDistanceSides=8,
        playerCubeSpaceLength=49,
        cubeSpaceAngle=30,
        cubeSpaceDepth=4
    )
    charterBox = CharterBox(charterBoxDimensions, document)
    charterBox.createBox()

